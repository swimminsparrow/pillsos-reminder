<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Scrollable Content Area -->
    <ScrollView
        android:id="@+id/scrollViewOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_bottom_bar"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Stepper Progress Bars -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_step_progress_inactive" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_step_progress_active" />
            </LinearLayout>

            <!-- Step Badge -->
            <TextView
                style="@style/TextAppearance.PillSOS.PillLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.08"
                android:text="@string/onboarding_step_2_badge" />

            <!-- Screen Header -->
            <TextView
                style="@style/TextAppearance.PillSOS.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/onboarding_notifications_title" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="@string/onboarding_notifications_subtitle" />

            <!-- Section 1 Header: ESSENTIAL -->
            <TextView
                style="@style/TextAppearance.PillSOS.PillLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="@string/onboarding_badge_essential"
                android:textColor="#DC2626"
                android:textSize="11sp" />

            <!-- Card 0: Notification Permission -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotificationPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#D6E2DA"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_recommended">

                        <ImageView
                            android:id="@+id/ivNotificationIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/onboarding_perm_notif_title"
                            android:src="@drawable/ic_notifications_bell_24"
                            app:tint="@color/defaultColor" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PillSOS.CardHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_perm_notif_title"
                            android:textSize="14.5sp" />

                        <TextView
                            style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:text="@string/onboarding_perm_notif_desc"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationPerm"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/onboarding_perm_enable"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2 Header: RECOMMENDED -->
            <TextView
                style="@style/TextAppearance.PillSOS.PillLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="@string/onboarding_badge_recommended"
                android:textColor="#D97706"
                android:textSize="11sp" />

            <!-- Card 1: Battery Optimization -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#D6E2DA"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_recommended">

                        <ImageView
                            android:id="@+id/ivBatteryStatusIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/onboarding_battery_title"
                            android:src="@drawable/outline_battery_status_good_24"
                            app:tint="@color/defaultColor" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PillSOS.CardHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_battery_title"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tvBatteryStatusSubtitle"
                            style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:text="@string/onboarding_battery_desc"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatteryOpt"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/onboarding_perm_enable"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Overlay Permission -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#D6E2DA"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_recommended">

                        <ImageView
                            android:id="@+id/ivOverlayStatusIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/onboarding_overlay_title"
                            android:src="@drawable/ic_fall_detection_24"
                            app:tint="@color/defaultColor" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PillSOS.CardHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_overlay_title"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tvOverlayStatusSubtitle"
                            style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:text="@string/onboarding_overlay_desc"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlayPerm"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/onboarding_perm_enable"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Bar (Always Visible) -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_screen"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start_MainActivity"
            style="@style/PositiveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/start_app"
            android:textSize="15.5sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_chevron_right_24"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</RelativeLayout>
