<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 🔹 PROFILE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/photo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/mFoto"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"
                app:strokeColor="@color/defaultColor"
                app:strokeWidth="2.5dp" />

            <!-- Mini Floating Camera Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="@color/defaultColor"
                app:cardCornerRadius="13dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera_alt_black_24dp"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/editPhotoText"
            style="@style/TextAppearance.PillSOS.PillValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/tap_to_change_photo" />
    </LinearLayout>

    <!-- 🔹 PREFERENCES -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>