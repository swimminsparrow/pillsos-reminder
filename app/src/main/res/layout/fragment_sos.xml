<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Connect Contact Card Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConnectContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PillSOS.CardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sos_card_what_is_it_for" />

                    <TextView
                        android:id="@+id/tvSosNetworkDesc"
                        style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sos_emergency_network_desc" />

                    <TextView
                        android:id="@+id/btnSosLearnWhenSent"
                        style="@style/TextAppearance.PillSOS.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp"
                        android:paddingEnd="6dp"
                        android:text="@string/sos_learn_when_sent"
                        android:textColor="@color/defaultColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/baseline_chevron_right_24"
                        app:drawableTint="@color/defaultColor" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectContact"
                        style="@style/PositiveButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/sos_connect_new_contact"
                        android:textSize="15sp"
                        app:icon="@drawable/baseline_person_24"
                        app:iconTint="@android:color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title -->
            <TextView
                android:id="@+id/tvSectionTitle"
                style="@style/TextAppearance.PillSOS.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="@string/sos_your_contacts" />

            <!-- Unified Contacts RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_sos_contact" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/baseline_sos_24"
                    app:tint="#BDBDBD" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    style="@style/TextAppearance.PillSOS.CardHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sos_no_contacts" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/sos_no_contacts_desc" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
