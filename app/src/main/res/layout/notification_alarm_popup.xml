<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Medication / Alarm Name (Primary Title) -->
    <TextView
        android:id="@+id/notification_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Test Allarme"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <!-- Alarm Time / Message (Subtitle) -->
    <TextView
        android:id="@+id/notification_alarm_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="20:00"
        android:textColor="#D1D1D6"
        android:textSize="14sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Divider Line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#33FFFFFF" />

    <!-- Action Buttons Row: Spegni | Posponi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Spegni (Dismiss) Container -->
        <FrameLayout
            android:id="@+id/btn_notification_dismiss_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/btn_notification_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/alarm_dismiss"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Vertical Divider -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#40FFFFFF" />

        <!-- Posponi (Snooze) Container -->
        <FrameLayout
            android:id="@+id/btn_notification_snooze_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/btn_notification_snooze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/snooze"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
