<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_step_progress_inactive" />

    <!-- Header with Sparkle/Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_recommended">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/whatsnew"
                android:src="@drawable/baseline_done_24"
                app:tint="@color/defaultColor" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PillSOS.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew"
                android:textSize="22sp" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/whatsnew_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:background="#E2E8F0" />

    <!-- Feature 1: 20 Languages -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_recommended">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_language_24"
                app:tint="@color/defaultColor" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PillSOS.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew_feat1_title"
                android:textSize="15sp" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/whatsnew_feat1_desc"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feature 2: SOS Emergency Network -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_optional">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_sos_24"
                app:tint="@color/defaultColor" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PillSOS.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew_feat2_title"
                android:textSize="15sp" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/onboarding_sos_desc"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feature 3: Modern Bio Theme & Reliability -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_recommended">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/outline_battery_status_good_24"
                app:tint="@color/defaultColor" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PillSOS.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew_feat3_title"
                android:textSize="15sp" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/whatsnew_feat3_desc"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feature 4: Open Source -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_optional">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_code_24"
                app:tint="@color/defaultColor" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PillSOS.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew_feat4_title"
                android:textSize="15sp" />

            <TextView
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/whatsnew_feat4_desc"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Got it Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWhatsNewGotIt"
        style="@style/PositiveButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_close"
        android:textSize="15.5sp"
        app:cornerRadius="14dp" />

</LinearLayout>
