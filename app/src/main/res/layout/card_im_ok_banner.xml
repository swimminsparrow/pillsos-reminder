<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_im_ok_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/im_ok_banner_stroke"
    app:cardBackgroundColor="@color/im_ok_banner_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_im_ok_banner_title"
                style="@style/TextAppearance.PillSOS.ListItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/im_ok_banner_title" />

            <TextView
                android:id="@+id/tv_im_ok_banner_subtitle"
                style="@style/TextAppearance.PillSOS.ListItemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/im_ok_banner_subtitle" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_im_ok_action"
            style="@style/PositiveButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/im_ok"
            android:textSize="13sp"
            android:textAllCaps="false"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_favorite_24"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:iconPadding="5dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
