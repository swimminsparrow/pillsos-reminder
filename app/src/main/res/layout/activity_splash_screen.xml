<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/defaultColor"
    tools:context="swimminsparrow.ricordamelo.ui.splash.SplashScreen">

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splash_icon_card"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/splash_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="18dp"
                android:src="@drawable/icon"
                app:tint="@color/defaultColor"
                android:tint="@color/defaultColor"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/splash_title"
            style="@style/TextAppearance.PillSOS.SplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/splash_subtitle"
            style="@style/TextAppearance.PillSOS.SplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_tagline"
            android:alpha="0.9" />

    </LinearLayout>

</FrameLayout>
