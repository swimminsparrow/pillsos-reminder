<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:gravity="center_horizontal">

        <!-- Top Row with Close Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|top"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_close_white_24dp"
                app:tint="#9E9E9E"
                android:contentDescription="@string/btn_close" />
        </FrameLayout>

        <!-- App Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#18000000"
            app:cardBackgroundColor="@android:color/white">

            <ImageView
                android:id="@+id/ivRateAppIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvRateTitle"
            style="@style/TextAppearance.PillSOS.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rate_me_title"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvRateSubtitle"
            style="@style/TextAppearance.PillSOS.ListItemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/rate_me_desc"
            android:gravity="center" />

        <!-- 5 Interactive Stars -->
        <LinearLayout
            android:id="@+id/layoutStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/ivStar1"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_star_filled_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="1 star" />

            <ImageView
                android:id="@+id/ivStar2"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_star_filled_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="2 stars" />

            <ImageView
                android:id="@+id/ivStar3"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_star_filled_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="3 stars" />

            <ImageView
                android:id="@+id/ivStar4"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_star_filled_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="4 stars" />

            <ImageView
                android:id="@+id/ivStar5"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:src="@drawable/ic_star_filled_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="5 stars" />

        </LinearLayout>

        <!-- Rating Feedback Hint -->
        <TextView
            android:id="@+id/tvRatingHint"
            style="@style/TextAppearance.PillSOS.PillLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/rate_me_excellent_title"
            android:gravity="center" />

        <!-- Primary Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateSubmit"
            style="@style/PositiveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/rate_me_store_btn"
            android:textSize="15sp"
            app:icon="@drawable/ic_star_filled_24dp"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Secondary Remind Later Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemindLater"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/rate_me_later_btn"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <!-- Tertiary Never Ask Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeverAskAgain"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/rate_me_never_btn"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
